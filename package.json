{
  "name": "aifiction",
  "version": "0.1.0",
  "private": true,
  "description": "Personal workspace for long-form web novel pipelines",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @aifiction/web run dev",
    "dev:worker": "npm --workspace @aifiction/worker run dev",
    "web:health": "node scripts/web-health.mjs",
    "web:doctor": "node scripts/web-doctor.mjs",
    "db:bootstrap": "npm --workspace @aifiction/data run db:bootstrap",
    "db:generate": "npm --workspace @aifiction/data run db:generate",
    "db:v2-smoke": "npm --workspace @aifiction/data run db:v2-smoke",
    "db:sync-smoke": "npm --workspace @aifiction/data run db:sync-smoke",
    "db:check": "npm --workspace @aifiction/data run typecheck",
    "worker:check": "npm --workspace @aifiction/worker run typecheck",
    "web:check": "npm --workspace @aifiction/web run build",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run db:check && npm run worker:check && npm run web:check",
    "worker:sync": "npm --workspace @aifiction/worker run sync --",
    "db:workbench-smoke": "npm --workspace @aifiction/data run db:workbench-smoke",
    "machine:context": "node scripts/machine-context.mjs",
    "encoding:check": "node scripts/encoding-check.mjs",
    "db:protocol-smoke": "npm --workspace @aifiction/data run db:protocol-smoke",
    "plugins:manage": "npm --workspace @aifiction/data run plugins:manage --",
    "plugins:smoke": "npm --workspace @aifiction/data run plugins:smoke",
    "plugins:matrix:smoke": "npm --workspace @aifiction/data run plugins:matrix:smoke",
    "migration:compat:smoke": "npm --workspace @aifiction/data run migration:compat:smoke",
    "quickstart": "npm --workspace @aifiction/data run quickstart --",
    "quickstart:smoke": "npm --workspace @aifiction/data run quickstart:smoke",
    "workspace:init": "npm --workspace @aifiction/data run workspace:init --",
    "workspace:init:smoke": "npm --workspace @aifiction/data run workspace:init:smoke",
    "starter:matrix:smoke": "npm --workspace @aifiction/data run starter:matrix:smoke",
    "books:init": "npm --workspace @aifiction/data run books:init --",
    "books:init:smoke": "npm --workspace @aifiction/data run books:init:smoke",
    "writing:meta-check": "node scripts/writing-meta-check.mjs",
    "writing:budget-check": "node scripts/writing-budget-check.mjs"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
